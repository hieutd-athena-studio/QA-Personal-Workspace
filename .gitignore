# Dependencies
node_modules/

# Build output
dist/
out/
.vite/
# NOTE: build/ directory is NOT ignored — used by electron-builder for icons + entitlements

# Local SQLite
*.db
*.db-journal
*.db-wal
*.db-shm

# Drizzle-kit local dev DB (used only for migration generation, not runtime)
dev.db
dev.db-*

# TanStack Router auto-generated route tree
src/renderer/src/routeTree.gen.ts

# ESLint cache
.eslintcache

# DB snapshots (created at runtime in userData, but ignore if any leak into repo)
snapshots/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors — keep shared VSCode dotfiles, drop personal noise
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Electron-builder output
release/

# Coverage
coverage/
.nyc_output/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Husky internals
.husky/_/

# Obsidian — keep config + plugins, drop per-user workspace state + cache
Brain/.obsidian/workspace.json
Brain/.obsidian/workspace-mobile.json
Brain/.obsidian/workspaces.json
Brain/.obsidian/cache
Brain/.trash/

# macOS resource fork artifacts (created when unzipping on Windows from a Mac zip)
__MACOSX/
**/__MACOSX/

# Design source archives — keep extracted folder as reference, drop zips
Brain/*.zip
